# Copy to .env.deploy or provide these through your hosting platform.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_ACCESS_SECRET=replace-with-at-least-64-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-64-character-secret
PUBLIC_URL=http://localhost:8080

# Mailtrap Sandbox works for staging tests. Use a verified sending provider in production.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Eminence HRIS <noreply@eminence.test>
