# Environment Variables — Eminence HRIS Backend

# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string (local dev example)
DATABASE_URL="postgresql://hris_user:hris_password@localhost:5432/eminence_hris?schema=public"

# ─── JWT ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=your-access-token-secret-here
JWT_REFRESH_SECRET=your-refresh-token-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Supabase Storage ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=hris-documents

# ─── Google Document AI (PDS OCR) ──────────────────────────────────────────
OCR_PROVIDER=GOOGLE_DOCUMENT_AI
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
DOCUMENT_AI_LOCATION=asia-south1
DOCUMENT_AI_PROCESSOR_ID=your-form-parser-processor-id
# Local development only. Prefer an attached service account in production.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-document-ai.json

# ─── Email (Mailtrap Email Sandbox for local testing) ──────────────────────
# Get the username/password from Mailtrap: Email Testing > Sandboxes >
# your sandbox > Integration > SMTP. Never commit real credentials.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your-mailtrap-sandbox-username
SMTP_PASS=your-mailtrap-sandbox-password
EMAIL_FROM="Eminence HRIS <noreply@eminence.test>"

# Links inside email messages point back to this frontend.
CLIENT_URL=http://localhost:5173

# ─── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
