# Environment Variables — Eminence HRIS Backend

# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string (local dev example)
DATABASE_URL="postgresql://hris_user:hris_password@localhost:5432/eminence_hris?schema=public"

# ─── JWT ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=your-access-token-secret-here
JWT_REFRESH_SECRET=your-refresh-token-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Supabase Storage ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=hris-documents

# ─── Google Cloud Vision (OCR) ─────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ─── Email (AWS SES or SendGrid) ───────────────────────────────────────────
EMAIL_PROVIDER=ses
AWS_SES_REGION=ap-southeast-1
AWS_SES_FROM_ADDRESS=noreply@eminence-hris.deped.gov.ph
SENDGRID_API_KEY=your-sendgrid-api-key

# ─── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
