generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        UserRole @unique
  description String?
  users       User[]

  @@map("roles")
}

model User {
  id                       Int                      @id @default(autoincrement())
  /// Stored as citext, so the unique index is case-insensitive: Juan@deped.gov.ph
  /// and juan@deped.gov.ph can no longer both exist, and an equality lookup
  /// matches regardless of case *while still using the index*.
  email                    String                   @unique @db.Citext
  passwordHash             String                   @map("password_hash")
  roleId                   Int                      @map("role_id")
  accountStatus            AccountStatus            @default(PENDING) @map("account_status")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  lastLogin                DateTime?                @map("last_login")
  failedLoginAttempts      Int                      @default(0) @map("failed_login_attempts")
  /// Set when an administrator issues or resets a password. The API refuses every
  /// route except change-password until the holder sets their own, so an
  /// administrator-known password cannot be used to work in the system.
  mustChangePassword       Boolean                  @default(false) @map("must_change_password")
  lockedUntil              DateTime?                @map("locked_until")
  /// Whether sign-in from a new device needs an emailed code. On for every account
  /// created after the check was introduced; accounts that existed before (pilot
  /// data with placeholder emails) keep signing in without it.
  deviceVerification       Boolean                  @default(true) @map("device_verification")
  accountRequestsCreated   AccountCreationRequest[] @relation("AccountRequestCreatedUser")
  accountRequestsSubmitted AccountCreationRequest[] @relation("AccountRequestsSubmitted")
  complianceChecks         ComplianceCheck[]
  notifications            Notification[]
  /// The one link to this account's personnel record, owned by personnel.user_id.
  /// There is deliberately no mirror column on this side: two columns for one
  /// relationship could disagree, and authorization reads this link.
  personnel                Personnel?               @relation("PersonnelBelongsToUser")
  refreshTokens            RefreshToken[]
  trustedDevices           TrustedDevice[]
  loginChallenges          LoginChallenge[]
  assignedTransactions     Transaction[]            @relation("CurrentAssignee")
  uploadedDocuments        UploadedDocument[]       @relation("Uploader")
  validatedDocuments       UploadedDocument[]       @relation("Validator")
  reviewedPersonnelFiles   PersonnelFile[]          @relation("PersonnelFileReviewer")
  role                     Role                     @relation(fields: [roleId], references: [id])
  validationLogs           ValidationLog[]

  @@map("users")
}

/// `token` holds a SHA-256 hash of the refresh token, never the token itself.
model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  /// "web" sessions end after webRefreshIdleMinutes unused; "app" ones do not.
  client     String   @default("web")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

/// A browser or phone that passed an emailed sign-in code. Only a hash of the
/// device token is stored; the device holds the token itself.
model TrustedDevice {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  label      String
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("trusted_devices")
}

/// One pending "is this you?" sign-in: a hashed 6-digit code and its limits.
model LoginChallenge {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  codeHash    String    @map("code_hash")
  label       String
  ipAddress   String?   @map("ip_address")
  attempts    Int       @default(0)
  lastSentAt  DateTime  @default(now()) @map("last_sent_at")
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_challenges")
}

model UsedMagicToken {
  id        Int      @id @default(autoincrement())
  jti       String   @unique
  userId    Int      @map("user_id")
  usedAt    DateTime @default(now()) @map("used_at")
  expiresAt DateTime @map("expires_at")

  @@map("used_magic_tokens")
}

model Personnel {
  files                 PersonnelFile[]
  id                    Int                    @id @default(autoincrement())
  userId                Int                    @unique @map("user_id")
  employeeId            String                 @unique @map("employee_id")
  firstName             String                 @map("first_name")
  lastName              String                 @map("last_name")
  middleName            String?                @map("middle_name")
  suffix                String?
  birthDate             DateTime?              @map("birth_date")
  gender                Gender?
  civilStatus           CivilStatus?           @map("civil_status")
  contactNumber         String?                @map("contact_number")
  address               String?
  /// Station assignment. AO II authorization scope is resolved from `school`
  /// only (src/utils/scope.util.ts); never re-derive it from address,
  /// designation or lastName free text, and never widen it to `district`.
  /// citext, so a plain `equals` is an exact case-insensitive match. Do not add
  /// `mode: 'insensitive'` to station filters: it compiles to ILIKE, where `_`
  /// and `%` are wildcards. A trigger canonicalises whitespace on write.
  school                String?                @db.Citext
  district              String?                @db.Citext
  designation           String
  dateHired             DateTime?              @map("date_hired")
  /// Printed in the service record STATUS column. Null means not on file, which
  /// prints as a blank for the issuing officer to complete rather than being
  /// asserted as PERMANENT, which is what the form used to do for every row.
  appointmentStatus     AppointmentStatus?  @map("appointment_status")
  status                PersonnelStatus
  plantillaItemId       Int?                   @unique @map("plantilla_item_id")
  profileComplete       Boolean                @default(false) @map("profile_complete")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  careerHistoryEntries  CareerHistoryEntry[]
  plantillaItem         PlantillaItem?         @relation(fields: [plantillaItemId], references: [id])
  user                  User                   @relation("PersonnelBelongsToUser", fields: [userId], references: [id])
  promotionApplications PromotionApplication[]
  transactions          Transaction[]

  @@index([school])
  @@index([district])
  @@map("personnel")
}

model PlantillaItem {
  id                  Int        @id @default(autoincrement())
  itemNumber          String     @unique @map("item_number")
  positionTitle       String     @map("position_title")
  salaryGrade         Int        @map("salary_grade")
  department          String
  division            String
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  /// Present exactly when the item is occupied. This relation *is* the
  /// occupancy state; there is no separate flag to keep in step with it.
  occupiedByPersonnel Personnel?

  @@map("plantilla_items")
}

model TransactionType {
  id                   Int                   @id @default(autoincrement())
  name                 String                @unique
  description          String?
  requirementTemplates RequirementTemplate[]
  transactions         Transaction[]

  @@map("transaction_types")
}

model Transaction {
  id                 Int                @id @default(autoincrement())
  personnelId        Int                @map("personnel_id")
  transactionTypeId  Int                @map("transaction_type_id")
  status             TransactionStatus
  submissionDate     DateTime?          @map("submission_date")
  validationDate     DateTime?          @map("validation_date")
  approvalDate       DateTime?          @map("approval_date")
  remarks            String?
  currentAssigneeId  Int?               @map("current_assignee_id")
  resubmissionCount  Int                @default(0) @map("resubmission_count")
  deficiencyDeadline DateTime?          @map("deficiency_deadline")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  currentAssignee    User?              @relation("CurrentAssignee", fields: [currentAssigneeId], references: [id])
  personnel          Personnel          @relation(fields: [personnelId], references: [id])
  transactionType    TransactionType    @relation(fields: [transactionTypeId], references: [id])
  uploadedDocuments  UploadedDocument[]
  formDrafts         FormDraft[]

  @@index([personnelId])
  @@index([status])
  @@map("transactions")
}

model RequirementTemplate {
  id                Int                @id @default(autoincrement())
  transactionTypeId Int                @map("transaction_type_id")
  name              String
  description       String?
  isMandatory       Boolean            @default(true) @map("is_mandatory")
  expectedDataType  String             @map("expected_data_type")
  ocrFieldsJson     Json?              @map("ocr_fields_json")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  transactionType   TransactionType    @relation(fields: [transactionTypeId], references: [id])
  uploadedDocuments UploadedDocument[]

  @@map("requirement_templates")
}

model FormDraft {
  transactionId Int @map("transaction_id")
  templateId String @map("template_id")
  version String
  payload Json
  updatedAt DateTime @updatedAt @map("updated_at")
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@id([transactionId, templateId])
  @@map("form_drafts")
}

model UploadedDocument {
  revisions             DocumentRevision[]
  id                    Int                 @id @default(autoincrement())
  transactionId         Int                 @map("transaction_id")
  requirementTemplateId Int                 @map("requirement_template_id")
  storagePath           String              @map("storage_path")
  fileName              String              @map("file_name")
  fileSize              Int?                @map("file_size")
  mimeType              String?             @map("mime_type")
  fileHash              String?             @map("file_hash")
  uploadedByUserId      Int                 @map("uploaded_by_user_id")
  uploadDate            DateTime            @default(now()) @map("upload_date")
  status                DocumentStatus
  ocrExtractedDataJson  Json?               @map("ocr_extracted_data_json")
  ocrConfidenceScore    Float?              @map("ocr_confidence_score")
  correctedOcrDataJson  Json?               @map("corrected_ocr_data_json")
  validationNotes       String?             @map("validation_notes")
  validatedByUserId     Int?                @map("validated_by_user_id")
  validationDate        DateTime?           @map("validation_date")
  isDuplicate           Boolean             @default(false) @map("is_duplicate")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  careerHistoryEntry    CareerHistoryEntry?
  complianceCheck       ComplianceCheck?
  requirementTemplate   RequirementTemplate @relation(fields: [requirementTemplateId], references: [id])
  transaction           Transaction         @relation(fields: [transactionId], references: [id])
  uploadedBy            User                @relation("Uploader", fields: [uploadedByUserId], references: [id])
  validatedBy           User?               @relation("Validator", fields: [validatedByUserId], references: [id])

  @@unique([transactionId, requirementTemplateId])
  @@map("uploaded_documents")
}

model ComplianceCheck {
  id                 Int              @id @default(autoincrement())
  uploadedDocumentId Int              @unique @map("uploaded_document_id")
  isCompliant        Boolean          @map("is_compliant")
  deficiencyDetails  String?          @map("deficiency_details")
  checkedByUserId    Int              @map("checked_by_user_id")
  checkDate          DateTime         @default(now()) @map("check_date")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  checkedBy          User             @relation(fields: [checkedByUserId], references: [id])
  uploadedDocument   UploadedDocument @relation(fields: [uploadedDocumentId], references: [id])

  @@map("compliance_checks")
}

model ValidationLog {
  id          Int      @id @default(autoincrement())
  entityType  String   @map("entity_type")
  entityId    Int      @map("entity_id")
  action      String
  detailsJson Json?    @map("details_json")
  userId      Int      @map("user_id")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  status      String   @default("SUCCESS")
  timestamp   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
  @@map("validation_logs")
}

model Notification {
  id                Int              @id @default(autoincrement())
  userId            Int              @map("user_id")
  message           String
  type              NotificationType
  isRead            Boolean          @default(false) @map("is_read")
  createdAt         DateTime         @default(now()) @map("created_at")
  relatedEntityId   Int?             @map("related_entity_id")
  relatedEntityType String?          @map("related_entity_type")
  user              User             @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

model PromotionCycle {
  id                     Int                    @id @default(autoincrement())
  name                   String
  type                   PromotionCycleType
  startDate              DateTime               @map("start_date")
  endDate                DateTime               @map("end_date")
  status                 PromotionCycleStatus
  rulesConfigurationJson Json?                  @map("rules_configuration_json")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  promotionApplications  PromotionApplication[]

  @@map("promotion_cycles")
}

model PromotionApplication {
  applicantNumber String? @unique @map("applicant_number")
  id               Int                        @id @default(autoincrement())
  personnelId      Int                        @map("personnel_id")
  promotionCycleId Int                        @map("promotion_cycle_id")
  status           PromotionApplicationStatus
  applicationDate  DateTime                   @default(now()) @map("application_date")
  finalRank        Int?                       @map("final_rank")
  scoreDetailsJson Json?                      @map("score_details_json")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")
  personnel        Personnel                  @relation(fields: [personnelId], references: [id])
  promotionCycle   PromotionCycle             @relation(fields: [promotionCycleId], references: [id])

  @@unique([personnelId, promotionCycleId])
  @@index([promotionCycleId])
  @@map("promotion_applications")
}

/// A document in a person's Digital 201 file.
///
/// Held as a JSONB payload until migration 202609220005. The shape was declared
/// in TypeScript and enforced nowhere, so the database could not reject an
/// unknown document type or an impossible status, and "which licences expire
/// next month" meant reading and parsing every row.
model PersonnelFile {
  id                 Int                     @id @default(autoincrement())
  personnelId        Int                     @map("personnel_id")
  personnel          Personnel               @relation(fields: [personnelId], references: [id])
  documentTypeId     String                  @map("document_type_id")
  documentTypeName   String                  @map("document_type_name")
  originalFileName   String?                 @map("original_file_name")
  storedFileName     String?                 @map("stored_file_name")
  storagePath        String?                 @map("storage_path")
  mimeType           String?                 @map("mime_type")
  fileSize           Int?                    @map("file_size")
  isRequired         Boolean                 @default(false) @map("is_required")
  issueDate          DateTime?               @map("issue_date") @db.Date
  expirationDate     DateTime?               @map("expiration_date") @db.Date
  remarks            String?
  status             PersonnelDocumentStatus @default(NOT_SUBMITTED)
  rejectionReason    String?                 @map("rejection_reason")
  reviewedAt         DateTime?               @map("reviewed_at")
  reviewedByUserId   Int?                    @map("reviewed_by_user_id")
  reviewedBy         User?                   @relation("PersonnelFileReviewer", fields: [reviewedByUserId], references: [id])
  /// The document this one supersedes. A replacement is a new immutable row, so
  /// an application that cited the earlier bytes still resolves to them.
  replacesDocumentId Int?                    @map("replaces_document_id")
  replaces           PersonnelFile?          @relation("PersonnelFileReplacement", fields: [replacesDocumentId], references: [id])
  replacedBy         PersonnelFile[]         @relation("PersonnelFileReplacement")
  ocrExtractedDataJson Json?                  @map("ocr_extracted_data_json")
  ocrConfidenceScore   Float?                 @map("ocr_confidence_score")
  ocrStatus            String?                @map("ocr_status")
  ocrProcessedAt       DateTime?              @map("ocr_processed_at")
  ocrErrorMessage      String?                @map("ocr_error_message")
  deletedAt          DateTime?               @map("deleted_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  @@index([personnelId, deletedAt])
  @@index([expirationDate])
  @@map("personnel_files")
}

model DocumentRevision {
  id String @id @default(uuid())
  documentId Int @map("document_id")
  document UploadedDocument @relation(fields: [documentId], references: [id])
  snapshot Json
  createdAt DateTime @default(now()) @map("created_at")
  @@index([documentId])
  @@map("document_revisions")
}

model WorkflowOutbox {
  id String @id @default(uuid())
  eventKey String @unique @map("event_key")
  kind String
  payload Json
  attempts Int @default(0)
  availableAt DateTime @default(now()) @map("available_at")
  processedAt DateTime? @map("processed_at")
  lastError String? @map("last_error")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([processedAt, availableAt])
  @@map("workflow_outbox")
}

model CareerHistoryEntry {
  id                 Int               @id @default(autoincrement())
  personnelId        Int               @map("personnel_id")
  eventType          CareerEventType   @map("event_type")
  eventDate          DateTime          @map("event_date")
  detailsJson        Json?             @map("details_json")
  documentId         Int?              @unique @map("document_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  supportingDocument UploadedDocument? @relation(fields: [documentId], references: [id])
  personnel          Personnel         @relation(fields: [personnelId], references: [id])

  @@map("career_history_entries")
}

model AccountCreationRequest {
  id                Int                  @id @default(autoincrement())
  requestedByUserId Int                  @map("requested_by_user_id")
  firstName         String               @map("first_name")
  lastName          String               @map("last_name")
  middleName        String?              @map("middle_name")
  suffix            String?
  email             String               @db.Citext
  birthDate         DateTime?            @map("birth_date")
  gender            Gender?
  civilStatus       CivilStatus?         @map("civil_status")
  contactNumber     String?              @map("contact_number")
  address           String?
  role              UserRole
  designation       String
  school            String?
  district          String?
  initialPassword   String               @map("initial_password")
  dateHired          DateTime?            @map("date_hired")
  pdsOriginalFileName String?             @map("pds_original_file_name")
  pdsStoragePath      String?             @map("pds_storage_path")
  pdsMimeType         String?             @map("pds_mime_type")
  pdsFileSize         Int?                @map("pds_file_size")
  status              AccountRequestStatus @default(PENDING)
  rejectionReason   String?              @map("rejection_reason")
  createdUserId     Int?                 @map("created_user_id")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  createdUser       User?                @relation("AccountRequestCreatedUser", fields: [createdUserId], references: [id])
  requestedByUser   User                 @relation("AccountRequestsSubmitted", fields: [requestedByUserId], references: [id])

  @@map("account_creation_requests")
}

enum UserRole {
  SYSTEM_ADMIN
  AO_II
  HRMO
  TEACHING_PERSONNEL
  NON_TEACHING_PERSONNEL
  // Still present in the database. supabase/migrations/20260812120000 tried to remove it
  // with ALTER TYPE ... DROP VALUE, which PostgreSQL does not support, so that statement
  // never ran. No account holds this role; removing the value needs an enum rebuild.
  RECORDS_PERSONNEL
}

/// Workflow: DRAFT -> PENDING_VALIDATION (AO II) -> FOR_APPROVAL (HRMO) -> APPROVED,
/// with DEFICIENCY for returns, REJECTED and ABANDONED (withdrawn selection).
/// ESCALATED, COMPLETED and ARCHIVED are reserved: no code sets them today, so
/// any filter or count on them is always empty. Removing them needs a migration.
enum TransactionStatus {
  DRAFT
  PENDING_VALIDATION
  FOR_APPROVAL
  APPROVED
  REJECTED
  DEFICIENCY
  ESCALATED
  ABANDONED
  COMPLETED
  ARCHIVED
}

enum DocumentStatus {
  PENDING_UPLOAD
  PENDING_OCR
  OCR_PROCESSED
  OCR_REVIEWED
  VALIDATED
  REJECTED
  REQUIRES_MANUAL_REVIEW
}

enum PromotionApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  RANKED
  APPROVED
  REJECTED
}

enum PromotionCycleType {
  RECLASSIFICATION
  NATURAL_VACANCY
  ECP
}

enum PromotionCycleStatus {
  PLANNING
  CONFIGURED
  ACTIVE
  CLOSED
  RESULTS_READY
  PUBLISHED
  FINALIZED
  EVALUATION
  COMPARATIVE_ASSESSMENT
  RESOLVED
  CANCELLED
}

enum CareerEventType {
  PROMOTION
  TRAINING
  AWARD
  DESIGNATION_CHANGE
  RECLASSIFICATION
  OTHER
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CivilStatus {
  SINGLE
  MARRIED
  WIDOWED
  SEPARATED
}

/// Employment status under CSC rules, as printed in the STATUS column of the
/// CS Form 212 service record. Distinct from PersonnelStatus, which tracks
/// whether a record is active in this system.
enum AppointmentStatus {
  PERMANENT
  PROVISIONAL
  TEMPORARY
  SUBSTITUTE
  CASUAL
  CONTRACTUAL
  COTERMINOUS
}

/// Review state of a document in the Digital 201 file.
///
/// Only SUBMITTED is reachable today: no endpoint reviews a 201 document, so
/// nothing moves one out of this state. The rest are the review workflow the
/// mobile app already renders. They are declared here so that when a reviewer
/// endpoint lands, the column decides what is legal - not a string literal.
enum PersonnelDocumentStatus {
  NOT_SUBMITTED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  REPLACEMENT_REQUIRED
}

enum PersonnelStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  RETIRED
  ARCHIVED
}

enum AccountStatus {
  PENDING
  ACTIVE
  LOCKED
  INACTIVE
}

enum AccountRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
